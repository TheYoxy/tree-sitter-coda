; CODA (Coded Statement of Account) highlights
; Generated from grammar.js. Each record kind gets a distinct colour on
; every field, and adjacent fields never share the same colour.

; ---------------------------------------------------------------------------
; Record classes
; ---------------------------------------------------------------------------
((record_type) @keyword.directive (#eq? @keyword.directive "0"))
((record_type) @type (#eq? @type "1"))
((record_type) @function (#eq? @function "2"))
((record_type) @label (#eq? @label "3"))
((record_type) @variable.parameter (#eq? @variable.parameter "4"))
((record_type) @character (#eq? @character "8"))
((record_type) @constant (#eq? @constant "9"))

; Article codes
((transaction_subtype) @variable.member (#eq? @variable.member "1"))
((transaction_subtype) @variable.parameter (#eq? @variable.parameter "2"))
((transaction_subtype) @string.special.symbol (#eq? @string.special.symbol "3"))
((information_subtype) @variable.member (#eq? @variable.member "1"))
((information_subtype) @variable.parameter (#eq? @variable.parameter "2"))
((information_subtype) @string.special.symbol (#eq? @string.special.symbol "3"))

; Fixed structural values
(unstructured_communication_flag) @operator
(structured_communication_flag) @operator
(structured_communication_type) @type.builtin
(zeros) @comment
(blank) @comment
(unused) @comment

; Transaction code
(transaction_code_type) @constant
(transaction_code_family) @type
(transaction_code_operation) @function
(transaction_code_category) @type.builtin

